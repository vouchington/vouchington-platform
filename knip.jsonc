{
  "$schema": "https://unpkg.com/knip/schema.json",
  // pr-shepherd: agent CLI, not imported from source.
  "ignoreDependencies": ["pr-shepherd"],
  // dependency-cruiser contract fixtures are invoked by test/dependency-cruiser.test.mts.
  "ignore": ["test/fixtures/dependency-cruiser/**"],
  "workspaces": {
    "packages/auth": {
      "entry": ["src/index.mts!"],
      "project": ["src/**/*.mts!", "!src/**/*.test.mts!"],
    },
    "packages/postgres": {
      "entry": ["src/index.mts!", "src/pg-schema-snapshot/index.mts!"],
      "project": ["src/**/*.mts!", "!src/**/*.test.mts!", "!src/**/test-helpers.mts!"],
    },
    "packages/utils": {
      "entry": [
        "src/token-secrets.mts!",
        "src/deploy-environment.mts!",
        "src/url-signing.mts!",
        "src/request-client-info.mts!",
        "src/money.mts!",
        "src/env-contract.mts!",
        "src/cookies.mts!",
        "src/hashtags.mts!",
        "src/utm.mts!",
        "src/fetch-ports.mts!",
        "src/observability.mts!",
      ],
      "project": ["src/**/*.mts!", "!src/**/*.test.mts!"],
    },
    "packages/session-jwt": {
      "entry": ["src/index.mts!"],
      "project": ["src/**/*.mts!", "!src/**/*.test.mts!"],
    },
    "packages/queue-errors": {
      "entry": ["src/index.mts!"],
      "project": ["src/**/*.mts!", "!src/**/*.test.mts!"],
    },
    "packages/worker-runtime": {
      "entry": ["src/index.mts!"],
      "project": ["src/**/*.mts!", "!src/**/*.test.mts!"],
    },
    "packages/pagination": {
      "entry": ["src/index.mts!"],
      "project": ["src/**/*.mts!", "!src/**/*.test.mts!"],
    },
  },
}
