{
  "$schema": "https://unpkg.com/knip/schema.json",
  // pr-shepherd: agent CLI, not imported from source.
  "ignoreDependencies": ["pr-shepherd"],
  // dependency-cruiser contract fixtures are invoked by test/dependency-cruiser.test.mts.
  "ignore": ["test/fixtures/dependency-cruiser/**"],
  "workspaces": {
    "packages/auth": {
      "entry": ["src/index.mts!"],
      "project": ["src/**/*.mts!", "!src/**/*.test.mts!"],
    },
    "packages/postgres": {
      "entry": [
        "src/index.mts!",
        "src/pg-schema-snapshot/index.mts!",
        "src/views/index.mts!",
        "src/query-telemetry/index.mts!",
        "src/partitions/index.mts!",
        "src/catalog-guarded-ddl/index.mts!",
      ],
      "project": ["src/**/*.mts!", "!src/**/*.test.mts!", "!src/**/test-helpers.mts!"],
    },
    "packages/utils": {
      "entry": [
        "src/token-secrets.mts!",
        "src/ai-moderation.mts!",
        "src/bedrock-embeddings.mts!",
        "src/bedrock-embedding-batches.mts!",
        "src/deploy-environment.mts!",
        "src/url-signing.mts!",
        "src/request-client-info.mts!",
        "src/money.mts!",
        "src/env-contract.mts!",
        "src/cookies.mts!",
        "src/hashtags.mts!",
        "src/utm.mts!",
        "src/fetch-ports.mts!",
        "src/observability.mts!",
        "src/http-signatures.mts!",
        "src/cache-tags.mts!",
        "src/sentry-envelope.mts!",
        "src/scopes.mts!",
        "src/api-errors.mts!",
        "src/api-response-contract.mts!",
        "src/schema-growth.mts!",
        "src/web-push.mts!",
        "src/web-push-vapid.mts!",
        "src/web-push-binding.mts!",
        "src/service-worker-activation.mts!",
        "src/json-ld.mts!",
        "src/seo-metadata.mts!",
        "src/speculation-rules.mts!",
      ],
      "project": [
        "src/**/*.mts!",
        "!src/**/*.test.mts!",
        "!src/**/http-signatures-test-helpers.mts!",
      ],
    },
    "packages/session-jwt": {
      "entry": ["src/index.mts!"],
      "project": ["src/**/*.mts!", "!src/**/*.test.mts!"],
    },
    "packages/request-contract-validation": {
      "entry": ["src/index.mts!"],
      "project": ["src/**/*.mts!", "!src/**/*.test.mts!"],
    },
    "packages/queue-errors": {
      "entry": ["src/index.mts!"],
      "project": ["src/**/*.mts!", "!src/**/*.test.mts!"],
    },
    "packages/worker-runtime": {
      "entry": ["src/index.mts!", "src/testing/index.mts!"],
      "project": ["src/**/*.mts!", "!src/**/*.test.mts!"],
    },
    "packages/rate-limit": {
      "entry": ["src/index.mts!", "src/edge/index.mts!"],
      "project": ["src/**/*.mts!", "!src/**/*.test.mts!"],
    },
    "packages/sentry": {
      "entry": ["src/index.mts!", "src/node.mts!", "src/browser.mts!"],
      "project": ["src/**/*.mts!", "!src/**/*.test.mts!"],
    },
    "packages/pagination": {
      "entry": ["src/index.mts!"],
      "project": ["src/**/*.mts!", "!src/**/*.test.mts!"],
    },
    "packages/html-sanitizer": {
      "entry": ["src/index.mts!"],
      "project": ["src/**/*.mts!", "!src/**/*.test.mts!"],
    },
    "packages/api-client": {
      "entry": ["src/index.mts!", "src/paginated-list.mts!"],
      "project": ["src/**/*.mts!", "!src/**/*.test.mts!"],
    },
    "packages/localization": {
      "entry": ["src/index.mts!", "src/react/index.mts!"],
      "project": ["src/**/*.mts!", "!src/**/*.test.mts!"],
    },
    "packages/oauth-server": {
      "entry": ["src/index.mts!"],
      "project": ["src/**/*.mts!", "!src/**/*.test.mts!"],
    },
    "packages/ai": {
      "entry": [
        "src/openai/index.mts!",
        "src/providers/index.mts!",
        "src/structured-decisions/index.mts!",
        "src/usage/index.mts!",
      ],
      "project": ["src/**/*.mts!", "!src/**/*.test.mts!"],
    },
    "packages/localization-compiler": {
      "entry": ["src/index.mts!", "src/cli.mts!", "src/bin.mts!"],
      "project": ["src/**/*.mts!", "!src/**/*.test.mts!", "!src/**/test-helpers.mts!"],
    },
  },
}
