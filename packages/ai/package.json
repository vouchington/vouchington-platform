{
  "name": "@vouchington/ai",
  "version": "0.4.1",
  "description": "Provider-neutral model-call primitives: usage, pricing, JSON-output adapters, and structured-decision codecs.",
  "homepage": "https://github.com/vouchington/vouchington-platform/tree/main/packages/ai#readme",
  "license": "MIT",
  "author": "Jonathan Ong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vouchington/vouchington-platform.git",
    "directory": "packages/ai"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./openai": {
      "types": "./dist/openai/index.d.mts",
      "import": "./dist/openai/index.mjs",
      "default": "./dist/openai/index.mjs"
    },
    "./providers": {
      "types": "./dist/providers/index.d.mts",
      "import": "./dist/providers/index.mjs",
      "default": "./dist/providers/index.mjs"
    },
    "./structured-decisions": {
      "types": "./dist/structured-decisions/index.d.mts",
      "import": "./dist/structured-decisions/index.mjs",
      "default": "./dist/structured-decisions/index.mjs"
    },
    "./usage": {
      "types": "./dist/usage/index.d.mts",
      "import": "./dist/usage/index.mjs",
      "default": "./dist/usage/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "openai": "^7.45.1"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "openai": "^7.39.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
