{
  "name": "@vouchington/media",
  "version": "0.2.0",
  "description": "Media upload validation, stream lifecycle, and S3 primitives.",
  "homepage": "https://github.com/vouchington/vouchington-platform/tree/main/packages/media#readme",
  "bugs": {
    "url": "https://github.com/vouchington/vouchington-platform/issues"
  },
  "license": "MIT",
  "author": "Jonathan Ong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vouchington/vouchington-platform.git",
    "directory": "packages/media"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./s3": {
      "types": "./dist/s3.d.mts",
      "import": "./dist/s3.mjs",
      "default": "./dist/s3.mjs"
    },
    "./s3-presign": {
      "types": "./dist/s3-presign.d.mts",
      "import": "./dist/s3-presign.mjs",
      "default": "./dist/s3-presign.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1123.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
