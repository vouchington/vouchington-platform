{
  "name": "@vouchington/votes",
  "version": "0.0.0",
  "description": "Schema-owned, injectable append-only PostgreSQL vote store and HTTP mutation engine.",
  "homepage": "https://github.com/vouchington/vouchington-platform/tree/main/packages/votes#readme",
  "bugs": {
    "url": "https://github.com/vouchington/vouchington-platform/issues"
  },
  "license": "MIT",
  "author": "Jonathan Ong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vouchington/vouchington-platform.git",
    "directory": "packages/votes"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./api-server": {
      "types": "./dist/api-server.d.mts",
      "import": "./dist/api-server.mjs",
      "default": "./dist/api-server.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@vouchington/pagination": "^0.0.0",
    "@vouchington/postgres": "^0.0.3",
    "sql-template-strings": "^2.2.2"
  },
  "devDependencies": {
    "@jongleberry/api-server": "^2.1.0"
  },
  "peerDependencies": {
    "@jongleberry/api-server": "^2.1.0"
  },
  "peerDependenciesMeta": {
    "@jongleberry/api-server": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
