{
  "name": "@vouchington/oauth-client",
  "version": "0.1.0",
  "description": "AT Protocol OAuth client builder with injected stores and fetch, and an EC keyset parser.",
  "homepage": "https://github.com/vouchington/vouchington-platform/tree/main/packages/oauth-client#readme",
  "license": "MIT",
  "author": "Jonathan Ong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vouchington/vouchington-platform.git",
    "directory": "packages/oauth-client"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./atproto": {
      "types": "./dist/atproto/index.d.mts",
      "import": "./dist/atproto/index.mjs",
      "default": "./dist/atproto/index.mjs"
    }
  },
  "publishConfig": {
