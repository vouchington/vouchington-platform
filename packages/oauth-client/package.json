  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@atproto-labs/fetch-node": "^0.4.3",
    "@atproto-labs/handle-resolver-node": "^0.2.15",
    "@atproto/jwk": "^0.7.4",
    "@atproto/jwk-jose": "^0.2.4"
  },
  "devDependencies": {
    "@atproto/oauth-client-node": "^0.5.13"
  },
  "peerDependencies": {
    "@atproto/oauth-client-node": "^0.5.13"
  },
  "engines": {
    "node": ">=24.0.0"
  }
