{
  "name": "@vouchington/rate-limit",
  "version": "0.3.1",
  "description": "House layer over valkyries rate limiting: api-server middleware, overlapped limits, and Cloudflare edge bindings.",
  "homepage": "https://github.com/vouchington/vouchington-platform/tree/main/packages/rate-limit#readme",
  "license": "MIT",
  "author": "Jonathan Ong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vouchington/vouchington-platform.git",
    "directory": "packages/rate-limit"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./edge": {
      "types": "./dist/edge/index.d.mts",
      "import": "./dist/edge/index.mjs",
      "default": "./dist/edge/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@jongleberry/api-server": "^3.1.0",
    "valkyries": "^0.14.0"
  },
  "peerDependencies": {
    "@jongleberry/api-server": "^3.1.0",
    "valkyries": "^0.14.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
