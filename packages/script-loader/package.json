{
  "name": "@vouchington/script-loader",
  "version": "0.1.0",
  "description": "Shared browser script loader and a Cloudflare Turnstile widget hook.",
  "homepage": "https://github.com/vouchington/vouchington-platform/tree/main/packages/script-loader#readme",
  "license": "MIT",
  "author": "Jonathan Ong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vouchington/vouchington-platform.git",
    "directory": "packages/script-loader"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./turnstile": {
      "types": "./dist/turnstile.d.mts",
      "import": "./dist/turnstile.mjs",
      "default": "./dist/turnstile.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.3.1"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
