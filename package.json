{
  "name": "vouchington-platform-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Opinionated Vouchington runtime platform packages.",
  "homepage": "https://github.com/vouchington/vouchington-platform#readme",
  "bugs": {
    "url": "https://github.com/vouchington/vouchington-platform/issues"
  },
  "license": "MIT",
  "author": "Jonathan Ong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vouchington/vouchington-platform.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "pnpm run oxlint && pnpm run oxfmt:check && pnpm run knip && pnpm run dependency-cruiser",
    "oxlint": "oxlint --type-aware --deny-warnings",
    "oxlint:fix": "oxlint --type-aware --fix --deny-warnings",
    "oxfmt": "oxfmt",
    "oxfmt:check": "oxfmt --check",
    "knip": "knip",
    "dependency-cruiser": "pnpm run build && depcruise packages/*/dist",
    "actionlint": "github-actionlint"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.6.0",
    "github-actionlint": "^1.7.12",
    "knip": "^6.41.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "pr-shepherd": "^0.59.0",
    "semver": "^7.8.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
