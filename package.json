{
  "name": "vouchington-platform-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Opinionated Vouchington runtime platform packages.",
  "homepage": "https://github.com/vouchington/vouchington-platform#readme",
  "bugs": {
    "url": "https://github.com/vouchington/vouchington-platform/issues"
  },
  "license": "MIT",
  "author": "Jonathan Ong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vouchington/vouchington-platform.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project packages/script-loader/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:postgres": "vitest run --project postgres",
    "test:valkey": "vitest run --project valkey --passWithNoTests",
    "test:partial": "vitest run --passWithNoTests --coverage --coverage.reporter=text-summary --coverage.thresholds.lines=0 --coverage.thresholds.functions=0 --coverage.thresholds.statements=0 --coverage.thresholds.branches=0 --reporter=default --reporter=blob",
    "test:merge-coverage": "vitest --merge-reports=.vitest-reports --coverage --reporter=default",
    "test:bun-bundles": "node scripts/bun-bundle-smoke.mts",
    "lint": "pnpm run oxlint && pnpm run oxfmt:check && pnpm run knip && pnpm run dependency-cruiser",
    "oxlint": "oxlint --type-aware --deny-warnings",
    "oxlint:fix": "oxlint --type-aware --fix --deny-warnings",
    "oxfmt": "oxfmt",
    "oxfmt:check": "oxfmt --check",
    "knip": "knip",
    "dependency-cruiser": "pnpm run build && depcruise packages/*/dist",
    "actionlint": "github-actionlint"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "^18.7.2",
    "github-actionlint": "^1.7.12",
    "knip": "^6.44.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "semver": "^7.8.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
