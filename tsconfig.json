{
  "compilerOptions": {
    "paths": {
      "@vouchington/crawler-html": ["./packages/crawler-html/src/index.mts"],
      "@vouchington/http-transport": ["./packages/http-transport/src/index.mts"],
      "@vouchington/rss-parser": ["./packages/rss-parser/src/index.mts"],
      "@vouchington/session-jwt": ["./packages/session-jwt/src/index.mts"],
      "@vouchington/utils/strings": ["./packages/utils/src/strings.mts"],
      "@vouchington/utils/urls": ["./packages/utils/src/urls.mts"],
      "@vouchington/uuid-v7": ["./packages/uuid-v7/src/index.mts"]
    },
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["packages/*/src/**/*.mts", "packages/*/src/**/*.d.ts"]
}
