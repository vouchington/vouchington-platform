{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "rules": {
    "unicorn/prefer-node-protocol": "error",
    "radix": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "node:module",
            "importNames": ["createRequire"],
            "message": "Bundlers cannot follow createRequire; import the dependency statically."
          },
          {
            "name": "module",
            "importNames": ["createRequire"],
            "message": "Bundlers cannot follow createRequire; import the dependency statically."
          }
        ]
      }
    ],
    "max-lines": ["error", 200]
  },
  "overrides": [
    {
      "files": ["**/*.test.mts", "**/__tests__/**/*.mts"],
      "rules": {
        "max-lines": ["error", 500]
      }
    }
  ]
}
